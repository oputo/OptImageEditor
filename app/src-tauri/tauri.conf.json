{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OptImageEditor",
  "version": "../package.json",
  "identifier": "com.oputo.optimageeditor",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "OptImageEditor",
        "width": 1400,
        "height": 900
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJBQzI3Nzc3QTRDQjAxNzQKUldSMEFjdWtkM2ZDS3QwMlVzTnM0VTBBL2tvMUw3N3VLdU5kVHNqRk5EUjZVU0Vjd1YwRWhWR0cK",
      "endpoints": [
        "https://github.com/oputo/OptImageEditor/releases/latest/download/latest.json",
        "https://oputo.com/apps/optimageeditor/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
